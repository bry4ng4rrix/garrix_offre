# =============================================================================
# Garrix Offre — variables d'environnement
#
# 1. Copier ce fichier :      cp .env.example .env      (ou : make env)
# 2. Remplacer TOUTES les valeurs "change-me" (make env génère des secrets aléatoires)
# 3. Ne JAMAIS committer le fichier .env (il est dans .gitignore)
#
# Les valeurs "localhost" servent au lancement local (hors Docker).
# Dans Docker Compose, DATABASE_URL / REDIS_URL / CELERY_BROKER_URL sont
# automatiquement remplacées pour pointer vers les conteneurs "postgres" et "redis".
# =============================================================================

# ---------- Application ----------
APP_ENV=development              # development | test | production
DEBUG=false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console (lisible) | json (production)
API_PORT=8000                    # port exposé sur la machine hôte
# Origines autorisées pour CORS, séparées par des virgules (Flutter web, outils...)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Mettre à false après la création de votre compte pour bloquer les inscriptions
ALLOW_REGISTRATION=true

# ---------- PostgreSQL ----------
POSTGRES_USER=garrix
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=garrix_offre
POSTGRES_PORT=5433               # port exposé sur l'hôte (5433 pour éviter un conflit avec un PostgreSQL local)
DATABASE_URL=postgresql+psycopg://garrix:change-me-postgres-password@localhost:5433/garrix_offre

# ---------- Redis ----------
REDIS_PORT=6380                  # port exposé sur l'hôte
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1

# ---------- JWT ----------
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-jwt-secret-key-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Sécurité ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120        # requêtes / minute / IP sur toute l'API
AUTH_RATE_LIMIT_PER_MINUTE=10    # tentatives / minute / IP sur login et register
MAX_REQUEST_SIZE_MB=2            # taille max d'un body JSON
MAX_UPLOAD_SIZE_MB=10            # taille max d'un fichier uploadé

# ---------- n8n ----------
# Secret partagé : n8n l'envoie dans l'en-tête X-N8N-Webhook-Secret
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret
N8N_PORT=5678
N8N_BASE_URL=http://localhost:5678
# Clé de chiffrement des credentials n8n (générer une valeur aléatoire, ne jamais la changer ensuite)
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
N8N_DB_NAME=n8n
# URL du webhook du workflow "notification" (utilisée si NOTIFICATION_DELIVERY_MODE=n8n)
N8N_NOTIFICATION_WEBHOOK_URL=http://n8n:5678/webhook/garrix-notification

# ---------- Notifications ----------
# backend : FastAPI envoie lui-même Telegram / Email
# n8n     : FastAPI transmet les notifications au workflow n8n "notification"
NOTIFICATION_DELIVERY_MODE=backend

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true                # STARTTLS (port 587)
SMTP_USE_SSL=false               # SSL direct (port 465)

# ---------- Stockage des fichiers ----------
STORAGE_BACKEND=local
STORAGE_PATH=./storage

# ---------- Scraping ----------
# Identifiez-vous honnêtement auprès des sites (mettre une adresse de contact réelle)
SCRAPER_USER_AGENT=GarrixOffreBot/1.0 (+mailto:contact@example.com)
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_DEFAULT_RATE_LIMIT=30    # requêtes / minute / source si la source n'en définit pas
SCRAPER_MAX_JOBS_PER_RUN=200
# Autoriser les URLs de sources pointant vers des IP privées (uniquement en développement)
ALLOW_PRIVATE_SOURCE_URLS=false
# API officielle France Travail "Offres d'emploi v2" : créer une application gratuite sur
# https://francetravail.io, y ajouter l'API, puis copier ici ses identifiants.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Clés des API de données d'offres (catégorie "services"). Préfixe SOURCE_ obligatoire :
# la configuration d'une source ne peut lire QUE ces variables.
SOURCE_ADZUNA_APP_ID=            # https://developer.adzuna.com
SOURCE_ADZUNA_APP_KEY=
SOURCE_FINDWORK_API_KEY=         # https://findwork.dev
SOURCE_THE_MUSE_API_KEY=         # https://www.themuse.com/developers/api/v2
SOURCE_JOBDATALAKE_API_KEY=      # https://www.jobdatalake.com/register

# ---------- Offres ----------
JOB_STALE_AFTER_DAYS=30          # une offre non revue depuis N jours devient EXPIRED
JOB_ARCHIVE_AFTER_DAYS=60        # une offre expirée depuis N jours devient ARCHIVED

# ---------- Matching (valeurs par défaut, modifiables ensuite par utilisateur via l'API) ----------
MATCHING_SKILLS_WEIGHT=40
MATCHING_EXPERIENCE_WEIGHT=20
MATCHING_CONTRACT_WEIGHT=15
MATCHING_LOCATION_WEIGHT=10
MATCHING_SALARY_WEIGHT=10
MATCHING_LANGUAGE_WEIGHT=5
MATCHING_TITLE_WEIGHT=10
MATCHING_EXPERIENCE_LEVEL_WEIGHT=10
MATCHING_DEFAULT_THRESHOLD=75    # score à partir duquel une offre est "high match"

# ---------- IA (optionnelle) ----------
# none : règles déterministes uniquement (le matching n'utilise jamais l'IA)
# anthropic : Claude via le SDK officiel (AI_MODEL vide = claude-opus-5-5)
# ollama : modèle open source sur votre serveur (AI_MODEL vide = qwen3:4b, pas de clé)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# Ollama : depuis les conteneurs, la machine hôte s'appelle host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Sans GPU, un modèle local met 1 à 3 minutes par texte : prévoir 300 secondes
AI_TIMEOUT_SECONDS=120

# ---------- Ports ----------
# Chaque service est joignable directement sur son port (API_PORT, N8N_PORT, POSTGRES_PORT,
# REDIS_PORT, plus haut). En production (docker-compose.prod.yml) :
# N8N_BIND_ADDRESS=0.0.0.0 rend n8n accessible depuis Internet (après création de son compte
# propriétaire) ; 127.0.0.1 (défaut) = accessible uniquement depuis le serveur / tunnel SSH.
N8N_BIND_ADDRESS=127.0.0.1
# URL publique de n8n, ex. http://185.215.167.79:5678/ (renseignée par scripts/deploy.sh)
N8N_PUBLIC_URL=
# Reverse proxy nginx optionnel (docker compose --profile proxy up -d)
NGINX_PORT=8080
