      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⚠️ <b>Garrix Offre : service dégradé</b>\n{{ JSON.stringify($json.checks || $json.error || $json) }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram (à configurer)"
