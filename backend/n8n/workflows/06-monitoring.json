      "typeVersion": 1,
      "position": [
        0,
        -280
      ],
      "parameters": {}
    },
    {
      "id": "4e74f7a9-5088-52bb-b14c-03cfd1f14955",
      "name": "Vérifier /ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        -120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.GARRIX_API_URL }}/ready",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Workflow",
              "value": "monitoring"
            },
            {
              "name": "X-N8N-Execution-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "db2ffe55-46fc-55c6-a4af-30f0f00cf29c",
      "name": "Tout est OK ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        -180
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "020983a2-69f8-587f-97ff-bdb893712a3d",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ready",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "de0be8c3-58ac-599e-b1ce-aeac8e0428cf",
      "name": "Alerte Telegram",
