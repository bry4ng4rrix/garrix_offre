      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -420
      ],
      "parameters": {
        "content": "## Monitoring\n- Toutes les 15 min : /ready ; si l'API ou une dépendance est KO, alerte Telegram directe (l'API peut être indisponible).\n- Chaque soir : résumé de la journée sur Telegram.\n- Chaque nuit : expiration / archivage des anciennes offres.",
        "width": 560,
        "height": 260
      }
    },
    {
      "id": "41af1c4a-a725-51e5-8b35-830034cbef22",
      "name": "Toutes les 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -120
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "379b0181-f6d4-523f-8fc5-ecfc62edffd7",
      "name": "Lancer manuellement",
