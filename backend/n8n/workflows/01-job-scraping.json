              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "bd4b167f-1696-5724-9cc8-41580aa4f38e",
      "name": "XML vers JSON",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [
        1120,
        60
      ],
      "parameters": {
        "mode": "xmlToJson",
        "dataPropertyName": "data",
        "options": {
          "explicitArray": false
        }
      }
    },
    {
      "id": "acb924e9-d8e4-5cdd-830b-053d5a9d4820",
      "name": "Normaliser les offres",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        60
      ],
      "parameters": {
        "jsCode": "// Transforme le flux RSS (converti en JSON par le nœud XML) au format JobPayload de FastAPI.\n// La logique métier (normalisation fine, déduplication, matching) reste dans FastAPI.\nconst source = $('Collecte par le backend ?').item.json;\nconst channel = ($json.rss && $json.rss.channel) || {};\nlet entries = channel.item || [];\nif (!Array.isArray(entries)) entries = [entries];\nconst text = (value) => (value && typeof value === 'object' ? value._ || '' : value || '');\nconst jobs = entries.slice(0, 200).map((entry) => ({\n  external_id: text(entry.guid) || text(entry.link),\n  title: text(entry.title),\n  url: text(entry.link),\n  description: text(entry.description),\n  published_at: entry.pubDate ? new Date(text(entry.pubDate)).toISOString() : null,\n})).filter((job) => job.title);\nreturn { json: { source_id: source.id, source_name: source.name, jobs } };",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "5f2b68bf-d927-5737-b938-27237b41461a",
      "name": "Envoyer les offres à FastAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        60
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GARRIX_API_URL }}/api/v1/webhooks/n8n/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "X-N8N-Workflow",
              "value": "job-scraping"
            },
            {
              "name": "X-N8N-Execution-Id",
              "value": "={{ $execution.id }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $execution.id }}-{{ $json.source_id }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source_id: $json.source_id, jobs: $json.jobs }) }}"
      }
    },
    {
      "id": "8cb08ffd-0120-5259-9919-024783127437",
      "name": "Bilan de collecte (succès)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        60
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GARRIX_API_URL }}/api/v1/webhooks/n8n/scraping-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "X-N8N-Workflow",
              "value": "job-scraping"
            },
            {
              "name": "X-N8N-Execution-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source_id: $('Normaliser les offres').item.json.source_id, status: 'success', execution_id: $execution.id + '-' + $('Normaliser les offres').item.json.source_id, jobs_found: $json.data.received, jobs_created: $json.data.created }) }}"
      }
    },
    {
      "id": "e1badd87-4d3b-58f4-9605-0f37a9986333",
      "name": "Préparer le rapport d'erreur",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        260
      ],
      "parameters": {
        "jsCode": "// La lecture du flux a échoué : on le signale à FastAPI (notification aux administrateurs).\nconst source = $('Collecte par le backend ?').item.json;\nreturn {\n  json: {\n    source_id: source.id,\n    status: 'failed',\n    execution_id: `${$execution.id}-${source.id}`,\n    error_message: ($json.error && ($json.error.message || JSON.stringify($json.error))) || 'Erreur de lecture du flux',\n  },\n};",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "98431766-1ed4-5981-ab08-7a4db74acbcc",
      "name": "Bilan de collecte (échec)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        260
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GARRIX_API_URL }}/api/v1/webhooks/n8n/scraping-status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "X-N8N-Workflow",
              "value": "job-scraping"
            },
            {
              "name": "X-N8N-Execution-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      }
    }
