<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : écran de démarrage système noir avec l'icône de l'application. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/garrix_black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/garrix_black</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/garrix_black</item>
    </style>
</resources>
